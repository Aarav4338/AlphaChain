# Roostoo API Credentials
ROOSTOO_API_KEY=your_roostoo_api_key_here
ROOSTOO_SECRET_KEY=your_roostoo_secret_key_here
ROOSTOO_BASE_URL=https://mock-api.roostoo.com

# Trading Configuration Mode (testing | competition)
TRADING_MODE=competition

# Execution Profile (active_dynamic | baseline_sniper)
TRADING_PROFILE=active_dynamic

# Optional AWS Credentials (for remote EC2 provisioning & health checks)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
